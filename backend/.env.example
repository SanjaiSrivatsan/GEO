# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geo_db?retryWrites=true&w=majority

# Server
PORT=8000
NODE_ENV=development

# JWT Authentication
# IMPORTANT: Generate a secure JWT_SECRET for production
# Method 1 (Node.js): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Method 2 (OpenSSL): openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRE_IN=1440m

# Redis (for Bull job queues)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# Google Business Profile API
GOOGLE_API_KEY=your-google-api-key

# Google Custom Search API
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-google-cse-id

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# External APIs (BIS - Brand Intelligence System)
YOUTUBE_API_KEY=your-youtube-api-key
NEWS_API_KEY=your-newsapi-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# Groq LLM
GROQ_API_KEY=your-groq-api-key

# Logging
LOG_LEVEL=info
