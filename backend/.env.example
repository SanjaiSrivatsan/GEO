# Application
APP_NAME=GEO Backend API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/geo_db
DB_ECHO=False

# JWT Authentication
# IMPORTANT: Generate a secure SECRET_KEY for production
# Method 1 (Python): python -c "import secrets; print(secrets.token_urlsafe(32))"
# Method 2 (OpenSSL): openssl rand -hex 32
# Method 3 (PowerShell): -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
# Token expiry: 1440 minutes = 24 hours (adjust based on security requirements)
# Shorter expiry (60-180 min) = more secure, more frequent logins
# Longer expiry (720-1440 min) = less secure, better UX
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=True

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# Google Business Profile API
GOOGLE_API_KEY=your-google-api-key

# OpenAI (for LangChain)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=GEO/1.0

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Web Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
HEADLESS_BROWSER=True
