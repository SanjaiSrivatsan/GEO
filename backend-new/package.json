{
  "name": "geo-backend",
  "version": "1.0.0",
  "description": "GEO Backend API - AI-powered business entity optimization platform (MERN Stack)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "migrate": "node --loader ts-node/esm src/scripts/migrate-db.ts",
    "seed": "node --loader ts-node/esm src/scripts/seed-db.ts",
    "setup-indexes": "node --loader ts-node/esm src/scripts/setup-indexes.ts"
  },
  "keywords": [
    "geo",
    "business",
    "entity",
    "optimization",
    "ai",
    "intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "zod": "^3.22.4",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "bull": "^4.11.5",
    "redis": "^4.6.10",
    "puppeteer": "^21.5.0",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.3",
    "lodash": "^4.17.21",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  }
}
